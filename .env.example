# Bhumi Lipi Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env

# Server network binding
PORT=8000
HOST=0.0.0.0

# Path to SQLite database file (Render uses /tmp/bhumi.db, local default is data/bhumi.db)
BHUMI_DB=data/bhumi.db

# Optional base64 master signing secret (32 bytes).
# If left empty, a key will automatically be generated in keys/master.key.
# On Render, this is generated once automatically via render.yaml.
BHUMI_MASTER_B64=

# Strict mode: set to 1 in production to refuse startup if master key changed
BHUMI_STRICT=0

# Optional Google Gemini API key for the Bangla AI Assistant
# Leave empty to run without AI assistant (all registry features work 100% without external APIs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
